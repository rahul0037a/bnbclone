# Example values only. Keep real credentials in an ignored .env file.
NODE_ENV=development
PREVIEW_MODE=true
DB_NAME=wanderlust_preview_local
ATLASDB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/wanderlust_preview_local?retryWrites=true&w=majority
PORT=8081
# HOST defaults to 127.0.0.1 for previews and 0.0.0.0 otherwise.
# HOST=127.0.0.1
SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-cloud-api-key
CLOUD_API_SECRET=your-cloud-api-secret
# Render's proxy is detected automatically using its RENDER=true environment flag.
# For other hosts behind one trusted reverse proxy, set TRUST_PROXY=1 (or true).
# TRUST_PROXY=0 (or false) explicitly disables proxy trust.
# TRUST_PROXY=1
