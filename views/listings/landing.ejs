<% layout("layouts/boilerplate") %>

<!-- Unique styling for the premium landing page -->
<style>
  .landing-hero {
    position: relative;
    background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1920&q=80') no-repeat center center;
    background-size: cover;
    height: 60vh;
    min-height: 400px;
    border-radius: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    margin-bottom: 3rem;
    box-shadow: var(--card-shadow);
    overflow: hidden;
    animation: fadeIn 1s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-glass-card {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 1.5rem;
    padding: 3rem;
    max-width: 800px;
    width: 90%;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
  }

  [data-bs-theme="dark"] .hero-glass-card {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin-bottom: 1rem;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    opacity: 0.9;
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  }

  /* Interactive search container inside Hero */
  .hero-search-bar {
    background: var(--bg-primary);
    border-radius: 50px;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    max-width: 650px;
    margin: 0 auto;
  }

  .hero-search-input {
    border: none;
    background: transparent;
    padding: 0.75rem 1.5rem;
    width: 100%;
    outline: none;
    color: var(--text-primary);
    font-size: 1rem;
  }

  .hero-search-btn {
    background-color: var(--brand-primary);
    color: white;
    border: none;
    border-radius: 50px;
    padding: 0.75rem 2rem;
    font-weight: 600;
    transition: background-color 0.2s ease, transform 0.1s ease;
    white-space: nowrap;
  }

  .hero-search-btn:hover {
    background-color: var(--brand-hover);
    transform: scale(1.03);
    color: white;
  }

  /* Categories section */
  .section-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    position: relative;
    display: inline-block;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 50px;
    height: 3px;
    background-color: var(--brand-primary);
    border-radius: 2px;
  }

  .landing-categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  .category-tile {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 1.25rem 0.5rem;
    text-align: center;
    color: var(--text-primary);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 6px rgba(0,0,0,0.02);
  }

  .category-tile i {
    font-size: 1.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .category-tile p {
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0;
  }

  .category-tile:hover {
    background-color: var(--bg-primary);
    border-color: var(--brand-primary);
    transform: translateY(-5px);
    box-shadow: var(--card-shadow);
  }

  .category-tile:hover i {
    color: var(--brand-primary);
    transform: scale(1.1);
  }

  /* Host banner */
  .host-banner {
    background: linear-gradient(135deg, #ff385c 0%, #ff4d6d 100%);
    border-radius: 1.5rem;
    padding: 4rem 3rem;
    color: white;
    margin: 4rem 0;
    position: relative;
    overflow: hidden;
    box-shadow: var(--card-shadow);
  }

  .host-banner::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }

  .host-btn {
    background-color: white;
    color: #ff385c;
    border: none;
    padding: 0.75rem 2rem;
    font-weight: 700;
    border-radius: 50px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    text-decoration: none;
    display: inline-block;
  }

  .host-btn:hover {
    background-color: #fafafa;
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    color: #ff385c;
  }

  /* Features Grid */
  .feature-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 2rem;
    height: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--card-shadow);
  }

  .feature-icon-wrapper {
    background-color: rgba(255, 56, 92, 0.1);
    color: var(--brand-primary);
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    font-size: 1.5rem;
  }

  /* Responsive font adjustments */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.25rem;
    }
    .hero-subtitle {
      font-size: 1.1rem;
    }
    .hero-search-bar {
      flex-direction: column;
      border-radius: 1.5rem;
      padding: 0.75rem;
      gap: 0.5rem;
    }
    .hero-search-input {
      padding: 0.5rem 1rem;
      text-align: center;
    }
    .hero-search-btn {
      width: 100%;
      padding: 0.75rem;
    }
    .landing-hero {
      height: auto;
      padding: 4rem 1rem;
    }
    .hero-glass-card {
      padding: 2rem 1.5rem;
    }
    .host-banner {
      padding: 3rem 1.5rem;
      text-align: center;
    }
    .host-banner .d-flex {
      flex-direction: column;
      gap: 1.5rem;
    }
  }
</style>

<div class="container py-3">
  <!-- Hero Section -->
  <header class="landing-hero">
    <div class="hero-glass-card">
      <h1 class="hero-title">Find Your Next Adventure</h1>
      <p class="hero-subtitle">Discover unique homes, cozy cabins, and extraordinary spaces around the world.</p>
      
      <form class="hero-search-bar" action="/listings" method="GET">
        <i class="fa-solid fa-magnifying-glass text-secondary ms-3 d-none d-md-block fs-5"></i>
        <input 
          class="hero-search-input" 
          type="text" 
          name="search" 
          placeholder="Where do you want to go?" 
          aria-label="Search destination" 
          required
        />
        <button class="hero-search-btn" type="submit">Search</button>
      </form>
    </div>
  </header>

  <!-- Categories Section -->
  <section class="mb-5">
    <h2 class="section-title">Explore by Category</h2>
    <div class="landing-categories-grid">
      <!-- Direct query filter triggers -->
      <% categories.slice(0, 14).forEach(category => { %>
        <a href="/listings?category=<%= encodeURIComponent(category.name) %>" class="category-tile">
          <i class="<%= category.icon %>"></i>
          <p><%= category.name %></p>
        </a>
      <% }) %>
      <!-- All Categories link -->
      <a href="/listings" class="category-tile">
        <i class="fa-solid fa-border-all"></i>
        <p>View All</p>
      </a>
    </div>
  </section>

  <!-- Featured Listings Section -->
  <section class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
      <div>
        <h2 class="section-title mb-0">Featured Destinations</h2>
      </div>
      <a href="/listings" class="btn btn-outline-danger rounded-pill px-4 fw-semibold" style="border-color: var(--brand-primary); color: var(--brand-primary);">
        Explore All
      </a>
    </div>

    <% if (!featuredListings || featuredListings.length === 0) { %>
      <div class="text-center py-5 border rounded-3 bg-body-tertiary">
        <p class="text-muted mb-0">No featured properties available. Create one to get started!</p>
      </div>
    <% } else { %>
      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% featuredListings.forEach(listing => { %>
          <div class="card listing-card" style="width: 19rem;"><a href="/listings/<%= listing._id %>">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
            <div class="card-img-overlay"></div>
            <div class="card-body">
              <p class="card-text">
                <b><%= listing.title %></b>
                <span class="listing-location"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %></span>
                &#8377; <%= listing.price.toLocaleString("en-IN") %> per night
              </p>
            </div>
          </a></div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- Become a Host Call to Action -->
  <section class="host-banner">
    <div class="d-flex justify-content-between align-items-center flex-wrap position-relative" style="z-index: 2;">
      <div class="mb-3 mb-md-0 col-lg-8">
        <h2 class="fw-bold fs-1 mb-2">Airbnb your home</h2>
        <p class="fs-5 opacity-90 mb-0">Open your door to travelers and earn extra income. List your space on Wanderlust today.</p>
      </div>
      <div>
        <a href="/listings/new" class="btn host-btn">Get Started</a>
      </div>
    </div>
  </section>

  <!-- Value Propositions / Features Section -->
  <section class="mb-5 py-3">
    <h2 class="section-title">Why Book With Us?</h2>
    <div class="row g-4 mt-1">
      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <h3 class="fw-bold h5">Secure Bookings</h3>
          <p class="text-muted mb-0">Our platform guarantees payment protection and identity verification for safety and transparency.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <h3 class="fw-bold h5">Verified Properties</h3>
          <p class="text-muted mb-0">Every listing on our website is curated and checked for accurate photos, amenities, and location details.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <i class="fa-solid fa-headset"></i>
          </div>
          <h3 class="fw-bold h5">24/7 Global Support</h3>
          <p class="text-muted mb-0">Our multilingual support team is available around the clock to assist you with booking or hosting queries.</p>
        </div>
      </div>
    </div>
  </section>
</div>
