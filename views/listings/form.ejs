<% const p = property || {}; const action = editing ? '/listings/' + p._id + '?_method=PUT&_csrf=' + encodeURIComponent(csrfToken) : '/listings?_csrf=' + encodeURIComponent(csrfToken); %>
<form action="<%= action %>" method="POST" enctype="multipart/form-data" class="panel needs-validation" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2 class="form-section-title">01 / The essentials</h2>
  <div class="field"><label for="title">Property title</label><input class="form-control" id="title" name="listing[title]" required minlength="3" maxlength="160" value="<%= p.title || '' %>" placeholder="A quiet place with a view"></div>
  <div class="field"><label for="description">What makes your place special?</label><textarea class="form-control" id="description" name="listing[description]" rows="5" required minlength="20" maxlength="10000" placeholder="Describe the space, surroundings, and what guests can expect."><%= p.description || '' %></textarea><small class="muted">At least 20 characters. Keep details accurate and useful.</small></div>
  <div class="field"><label for="categories">Categories</label><select class="form-control" id="categories" name="listing[categories][]" multiple><% categories.forEach(c => { %><option value="<%= c.name %>" <%= (p.categories || ['Trending']).includes(c.name) ? 'selected' : '' %>><%= c.name %></option><% }) %></select><small class="muted">Choose up to 12 categories, or add a custom tag.</small></div>
  <h2 class="form-section-title">02 / A first impression</h2>
  <% if (editing && p.image && p.image.url) { %><img class="listing-thumb" src="<%= p.image.url %>" alt="Current cover photograph"><% } %>
  <div class="field"><label for="image"><%= editing ? 'Replace cover photo (optional)' : 'Cover photo' %></label><input class="form-control" id="image" name="listing[image]" type="file" accept="image/jpeg,image/png" <%= editing ? '' : 'required' %>><small class="muted">JPG or PNG, up to 5 MB. Only upload photography you have permission to use.</small></div>
  <h2 class="form-section-title">03 / Price and capacity</h2>
  <div class="form-grid"><div class="field"><label for="price">Nightly room price (INR)</label><input class="form-control" id="price" name="listing[price]" type="number" min="0" max="10000000" step="0.01" required value="<%= p.price ?? '' %>"></div><div class="field"><label for="totalRooms">Total available rooms</label><input class="form-control" id="totalRooms" name="listing[totalRooms]" type="number" min="1" max="20" step="1" required value="<%= p.totalRooms || 1 %>"></div><div class="field"><label for="maxGuests">Total guest capacity</label><input class="form-control" id="maxGuests" name="listing[maxGuests]" type="number" min="1" max="50" step="1" required value="<%= p.maxGuests || 2 %>"><small class="muted">Maximum guests across the whole property at the same time.</small></div></div>
  <h2 class="form-section-title">04 / Where to find it</h2>
  <div class="form-grid"><div class="field"><label for="location">City or area</label><input class="form-control" id="location" name="listing[location]" required maxlength="160" value="<%= p.location || '' %>" placeholder="e.g. Anjuna, Goa"></div><div class="field"><label for="country">Country</label><input class="form-control" id="country" name="listing[country]" required maxlength="100" value="<%= p.country || '' %>" placeholder="e.g. India"></div></div>
  <button type="button" class="button button-outline mb-3" id="preview-location-btn"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> Preview location</button>
  <div id="map-preview" class="map-frame mb-3" hidden <% if (p.geometry?.coordinates?.length === 2) { %>data-lng="<%= p.geometry.coordinates[0] %>" data-lat="<%= p.geometry.coordinates[1] %>"<% } %>></div><p id="map-preview-status" class="small muted" role="status"></p>
  <div class="action-row mt-4"><button class="button button-brand" type="submit"><%= editing ? 'Save changes' : 'Publish listing' %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button><a class="button button-outline" href="<%= editing ? '/listings/' + p._id : '/listings' %>">Cancel</a></div>
</form>
<script>document.addEventListener('DOMContentLoaded',function(){if (typeof TomSelect !== 'undefined') new TomSelect('#categories', {plugins:['remove_button'], create:true, createOnBlur:true, maxItems:12});});</script><script src="/js/map.js" defer></script>
