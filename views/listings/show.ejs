<% layout("layouts/boilerplate") %>

<div class="row mt-3 justify-content-center">
    <div class="col-lg-8 col-md-10 col-12 px-3">
        <h3><%= listing.title %></h3>
        <div class="view-card w-100">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing-image">
            <div class="card-body mb-3 mt-3">
                <!-- <h5 class="card-title"></h5> -->
                <p class="card-text">
                    Owned (Listed) By <i><%= listing.owner.username %></i>
                </p>
                <p class="card-text"><%= listing.description %></p>
                
            </div>
            <div class="mb-3">
                <p class="card-text">Price: &#8377;<%= listing.price.toLocaleString("en-IN") %> per night</p>
                <p class="card-text">Location: <%= listing.location %>, <%= listing.country %></p>
                <p class="card-text">Categories: <%= listing.categories.join(", ") %></p>
            </div>
            <div class="mb-3">
                <h5><i class="fa-solid fa-map-location-dot"></i> Where you'll be</h5>
                <div id="map"
                     <% if(listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
                     data-lng="<%= listing.geometry.coordinates[0] %>"
                     data-lat="<%= listing.geometry.coordinates[1] %>"
                     <% } %>
                     data-title="<%= listing.title %>"
                     data-location="<%= listing.location %>"
                     data-country="<%= listing.country %>">
                </div>
        </div>
        </div>
        <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
        <div class="card-btns mb-3">
            <a href="/listings/<%= listing._id %>/edit" class="btn add-btn text-white text-decoration-none d-inline-flex align-items-center justify-content-center">Edit</a>
            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" class="mb-0">
                <button class="btn btn-dark px-4 py-2 rounded-pill fw-semibold">Delete</button>
            </form>
        </div>
        <% } else { %>
        <div class="mb-3">
            <a href="/listings/<%= listing._id %>/book" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold" style="background-color: #ff385c; border-color: #ff385c; color: white;">
                <i class="fa-regular fa-calendar-check"></i> Book Listing
            </a>
        </div>
        <% } %>
        <hr>
        <% if(currUser) {%>
        <h4>Leave a Review</h4>
        <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
            <!-- <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
                <input type="range" min="1" max="5" class="form-range" name="review[rating]" id="rating">
            </div> -->
            <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            </div>
            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" class="form-control" required></textarea>
                <div class="invalid-feedback">Please add some comment for review</div>
            </div>
                
            <button class="btn btn-outline-dark">Submit</button>
            </form>
            <% } %>
            <p><b>All Reviews</b></p>
            <!-- <ul>
            <% for(review of listing.reviews) { %>
                <li> <%= review.comment %>, <%= review.rating %>/5</li>
            <% } %>
            </ul> -->

            <div class="row g-3">
                <% for(review of listing.reviews) { %>
                    <div class="col-md-6 col-12 mb-3">
                        <div class="card h-100">
                            <div class="card-body p-3">
                                <h6 class="card-title fw-bold">@<%= review.author.username %></h6>
                                <p class="starability-result card-text" data-rating="<%= review.rating %>">
                                    Rated: <%= review.rating %> stars
                                </p>
                                <p class="card-text mb-2"><%= review.comment %></p>
                            </div>
                            <div class="px-3 pb-3">
                                <form class="mb-0" method="POST" action="/listings/<%= listing.id %>/reviews/<%= review.id %>?_method=DELETE">
                                    <button class="btn btn-sm btn-dark">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
            
            <hr>
            <% if (similarListings && similarListings.length > 0) { %>
                <div class="similar-listings-section mt-4 mb-4">
                    <h4 class="fw-bold mb-4"><i class="fa-solid fa-wand-magic-sparkles text-danger"></i> Similar Listings</h4>
                    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
                        <% similarListings.forEach(similar => { %>
                            <div class="card listing-card" style="width: 19rem;"><a href="/listings/<%= similar._id %>">
                                <img src="<%= similar.image.url %>" class="card-img-top" alt="<%= similar.title %>">
                                <div class="card-img-overlay"></div>
                                <div class="card-body">
                                    <p class="card-text"><b><%= similar.title %> </b><br> &#8377; <%= similar.price.toLocaleString("en-IN") %> per night</p>
                                </div>
                            </a></div>
                        <% }) %>
                    </div>
                </div>
            <% } %>
        </div>
</div>
    <!-- <ul>
        <li> <%= listing.title %> </li>
        <li> <%= listing.description %> </li>
        <li> <img src="<%= listing.image %>" alt="Listing Image" width="300"/> </li>
        <li> &#8377; <%= listing.price.toLocaleString("en-IN") %> per night </li>
        <li> Location: <%= listing.location %>, <%= listing.country %> </li>
