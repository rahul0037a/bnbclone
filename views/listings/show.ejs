<% layout("layouts/boilerplate") %>
<% const owned = currUser && listing.owner && String(listing.owner._id) === String(currUser._id); const money = n => Number(n).toLocaleString('en-IN',{maximumFractionDigits:2}); %>
<section class="detail-top"><a href="/listings" class="small muted"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All stays</a><div class="mt-3"><span class="eyebrow"><%= listing.isCatalog ? 'THE WANDERLUST COLLECTION' : 'A PLACE TO CALL YOUR OWN' %></span><h1><%= listing.title %></h1><p class="muted"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= listing.location %>, <%= listing.country %></p></div>
<img src="<%= listing.image?.url || '' %>" alt="<%= listing.image?.isIllustrative ? 'Illustrative travel photograph, not this property' : listing.title %>" class="detail-photo"><% if (listing.image?.isIllustrative) { %><p class="photo-caption">Illustrative photograph. See the official property page for actual photos.</p><% } %>
<div class="detail-layout"><div class="detail-main"><section class="detail-section"><h2><%= listing.isCatalog ? 'Real place. A little travel inspiration.' : 'About this place' %></h2><p style="white-space:pre-line"><%= listing.description %></p><div class="capacity-row"><span><i class="fa-solid fa-bed" aria-hidden="true"></i> <%= listing.totalRooms || 1 %> demo rooms</span><span><i class="fa-solid fa-user-group" aria-hidden="true"></i> Up to <%= listing.maxGuests || 2 %> guests</span></div>
<% if (listing.isCatalog) { %><div class="catalog-note">Property name and destination sourced from <%= listing.sourceName || 'the official operator' %>. Prices and capacity are indicative demo values. This app does not make a reservation with the property.<% if (listing.sourceUrl) { %> <a href="<%= listing.sourceUrl %>" target="_blank" rel="noopener noreferrer">Visit the official property page <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a><% } %></div><% } else { %><p class="small muted mt-3">Listed by <%= listing.owner?.username || 'a WanderLust host' %>.</p><% } %>
<div class="tag-row mt-3"><% (listing.categories || []).forEach(c => { %><span><%= c %></span><% }) %></div></section>
<section class="detail-section"><h2>Find your bearings</h2><p class="muted small"><%= listing.coordinatesApproximate ? 'Approximate destination location; this pin is not the exact property address.' : 'Location shown from the listing address.' %></p><div id="map" class="map-frame" data-title="<%= listing.title %>" data-location="<%= listing.location %>" data-country="<%= listing.country %>" <% if (listing.geometry?.coordinates?.length === 2) { %>data-lng="<%= listing.geometry.coordinates[0] %>" data-lat="<%= listing.geometry.coordinates[1] %>"<% } %>><span class="muted small">Map loads when you reach this section.</span></div></section>
<section class="detail-section"><h2>Traveler notes <span class="muted">(<%= listing.reviews.length %>)</span></h2><% if (!listing.reviews.length) { %><p class="muted">No reviews yet. Be the first to leave a thoughtful note.</p><% } %><div class="review-grid"><% listing.reviews.forEach(review => { if (!review) return; %><article class="review-item"><strong><%= review.author?.username || 'Former member' %></strong><p class="review-rating my-2"><i class="fa-solid fa-star" aria-hidden="true"></i> <%= review.rating %> / 5</p><p><%= review.comment %></p><time class="muted small" datetime="<%= new Date(review.createdAt).toISOString() %>"><%= new Date(review.createdAt).toLocaleDateString('en-IN') %></time><% if (currUser && review.author && String(review.author._id) === String(currUser._id)) { %><form method="POST" class="mt-2" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-outline" type="submit">Delete review</button></form><% } %></article><% }) %></div>
<% if (currUser) { %><form class="needs-validation mt-4" method="POST" action="/listings/<%= listing._id %>/reviews" novalidate><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3 class="h6 fw-bold">Leave a review</h3><div class="field"><label for="rating">Your rating</label><select class="form-select" id="rating" name="review[rating]" required><option value="">Choose a rating</option><option value="5">5 — Wonderful</option><option value="4">4 — Very good</option><option value="3">3 — Good</option><option value="2">2 — Could be better</option><option value="1">1 — Disappointing</option></select></div><div class="field"><label for="comment">Your experience</label><textarea class="form-control" id="comment" name="review[comment]" required minlength="3" maxlength="3000" rows="3" placeholder="Share something useful with fellow travelers."></textarea></div><button class="button button-brand">Post review</button></form><% } else { %><p class="mt-3 small"><a href="/login">Log in</a> to share a review.</p><% } %></section></div>
<aside class="panel detail-aside"><span class="detail-price">₹<%= money(listing.price) %></span><span class="muted small"> / room / night</span><p class="small muted mt-2"><%= listing.ratesIndicative ? 'Indicative demo rate' : 'Demo reservation rate' %> · 18% demo tax added</p><div class="action-row my-3"><button type="button" class="button button-outline" data-save-id="<%= listing._id %>" data-save-title="<%= listing.title %>" aria-pressed="false" aria-label="Save <%= listing.title %>"><i class="fa-regular fa-heart" aria-hidden="true"></i> Save stay</button></div><% if (owned) { %><a class="button button-brand w-100" href="/listings/<%= listing._id %>/edit">Edit listing</a><form class="mt-2" method="POST" action="/listings/<%= listing._id %>?_method=DELETE"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-outline w-100">Archive listing</button></form><% } else { %><a class="button button-brand w-100" href="/listings/<%= listing._id %>/book">Plan a demo stay <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a><% } %><p class="small muted mt-3 mb-0">No payment. No real property reservation. Just a better way to explore.</p></aside></div>
<% if (similarListings?.length) { %><section class="page-section"><h2 class="h3 fw-bold mb-4">More places, more possibilities.</h2><div class="stay-grid"><% similarListings.forEach(item => { %><%- include('../includes/listing-card', { listing: item }) %><% }) %></div></section><% } %></section><script src="/js/map.js" defer></script>
