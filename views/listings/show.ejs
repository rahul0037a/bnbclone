<% layout("layouts/boilerplate") %>

<div class="row mt-4 justify-content-center">
    <div class="col-lg-9 col-md-11 col-12 px-3">

        <!-- Title & Location Subtitle -->
        <div class="mb-3">
            <h2 class="fw-bold mb-1"><%= listing.title %></h2>
            <p class="text-secondary small mb-0">
                <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %>
            </p>
        </div>

        <!-- Hero Showcase Image -->
        <div class="position-relative mb-4">
            <img src="<%= listing.image.url %>" class="card-img-top show-img rounded-4 shadow-sm" alt="<%= listing.title %>" style="width: 100%; max-height: 420px; object-fit: cover;">
        </div>

        <!-- Main Content & Sticky Action Card Grid -->
        <div class="row g-4 mb-4">
            <!-- Left Side Details -->
            <div class="col-lg-8">
                <!-- Host Info Card -->
                <div class="d-flex align-items-center gap-3 p-3 bg-body-tertiary rounded-3 mb-4 border">
                    <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 48px; height: 48px;">
                        <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Hosted by <%= listing.owner ? listing.owner.username : 'Host' %></h6>
                        <small class="text-secondary"><i class="fa-solid fa-shield-halved text-success me-1"></i>Verified Host</small>
                    </div>
                </div>

                <!-- Category Tags -->
                <% if (listing.categories && listing.categories.length > 0) { %>
                    <div class="mb-4">
                        <h6 class="fw-bold text-uppercase text-secondary small mb-2">Categories</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <% listing.categories.forEach(cat => { %>
                                <span class="badge rounded-pill bg-body-tertiary border text-body px-3 py-2 fw-normal fs-6">
                                    <i class="fa-solid fa-tag text-danger me-1"></i><%= cat %>
                                </span>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- Description -->
                <div class="mb-4">
                    <h5 class="fw-bold mb-2">About this place</h5>
                    <p class="text-body-secondary fs-6 leading-relaxed" style="white-space: pre-line;"><%= listing.description %></p>
                </div>
            </div>

            <!-- Right Side Price & Booking / Edit Box -->
            <div class="col-lg-4">
                <div class="card border shadow-sm p-4 rounded-4 bg-body-tertiary sticky-top" style="top: 90px; z-index: 1;">
                    <div class="mb-3">
                        <span class="fs-3 fw-bold">&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
                        <span class="text-secondary">/ night</span>
                    </div>

                    <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                        <div class="d-flex flex-column gap-2 mt-2">
                            <a href="/listings/<%= listing._id %>/edit" class="btn add-btn text-white px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center justify-content-center gap-2">
                                <i class="fa-solid fa-pen-to-square"></i> Edit Listing
                            </a>
                            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" class="mb-0">
                                <button class="btn btn-dark w-100 px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center justify-content-center gap-2">
                                    <i class="fa-solid fa-trash-can"></i> Delete Listing
                                </button>
                            </form>
                        </div>
                    <% } else { %>
                        <a href="/listings/<%= listing._id %>/book" class="btn btn-danger w-100 py-3 rounded-pill fw-semibold fs-6 d-inline-flex align-items-center justify-content-center gap-2" style="background-color: #ff385c; border-color: #ff385c; color: white;">
                            <i class="fa-regular fa-calendar-check fs-5"></i> Book Listing
                        </a>
                    <% } %>
                </div>
            </div>
        </div>

        <hr class="my-4">

        <!-- Map Section -->
        <div class="mb-5">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-map-location-dot text-danger me-2"></i>Where you'll be</h5>
            <div id="map"
                 <% if(listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
                 data-lng="<%= listing.geometry.coordinates[0] %>"
                 data-lat="<%= listing.geometry.coordinates[1] %>"
                 <% } %>
                 data-title="<%= listing.title %>"
                 data-location="<%= listing.location %>"
                 data-country="<%= listing.country %>">
            </div>
        </div>

        <hr class="my-4">

        <!-- Leave a Review Section -->
        <% if(currUser) { %>
            <div class="mb-5">
                <h4 class="fw-bold mb-3">Leave a Review</h4>
                <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="rating" class="form-label fw-semibold">Rating</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label fw-semibold">Comments</label>
                        <textarea name="review[comment]" id="comment" class="form-control" rows="3" placeholder="Share your experience..." required></textarea>
                        <div class="invalid-feedback">Please add some comment for review</div>
                    </div>
                    <button class="btn btn-outline-dark rounded-pill px-4 fw-semibold">Submit Review</button>
                </form>
            </div>
        <% } %>

        <!-- Reviews List -->
        <% if (listing.reviews && listing.reviews.length > 0) { %>
            <div class="mb-5">
                <h5 class="fw-bold mb-4"><i class="fa-solid fa-comments text-danger me-2"></i>All Reviews (<%= listing.reviews.length %>)</h5>
                <div class="row g-3">
                    <% for(review of listing.reviews) { %>
                        <div class="col-md-6 col-12">
                            <div class="card h-100 border shadow-sm rounded-3">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center small fw-bold" style="width: 32px; height: 32px;">
                                            <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                        <h6 class="card-title fw-bold mb-0">@<%= review.author ? review.author.username : 'anonymous' %></h6>
                                    </div>
                                    <p class="starability-result card-text" data-rating="<%= review.rating %>">
                                        Rated: <%= review.rating %> stars
                                    </p>
                                    <p class="card-text mb-2 text-secondary"><%= review.comment %></p>
                                </div>
                                <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                    <div class="px-3 pb-3">
                                        <form class="mb-0" method="POST" action="/listings/<%= listing.id %>/reviews/<%= review.id %>?_method=DELETE">
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="fa-solid fa-trash-can me-1"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        <% } %>

        <!-- Similar Listings -->
        <% if (similarListings && similarListings.length > 0) { %>
            <hr class="my-4">
            <div class="similar-listings-section mt-4 mb-4">
                <h4 class="fw-bold mb-4"><i class="fa-solid fa-wand-magic-sparkles text-danger me-2"></i>Similar Listings</h4>
                <div class="row g-3">
                    <% similarListings.forEach(similar => { %>
                        <div class="col-lg-4 col-md-6 col-12 d-flex justify-content-center">
                            <div class="card listing-card w-100" style="max-width: 19rem;"><a href="/listings/<%= similar._id %>">
                                <img src="<%= similar.image.url %>" class="card-img-top" alt="<%= similar.title %>">
                                <div class="card-img-overlay"></div>
                                <div class="card-body">
                                    <p class="card-text">
                                        <b><%= similar.title %></b>
                                        <span class="listing-location"><i class="fa-solid fa-location-dot me-1"></i><%= similar.location %><% if (similar.country) { %>, <%= similar.country %><% } %></span>
                                        &#8377; <%= similar.price.toLocaleString("en-IN") %> per night
                                    </p>
                                </div>
                            </a></div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>

    </div>
</div>

<script src="/js/map.js"></script>
