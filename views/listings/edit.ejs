<% layout("/layouts/boilerplate") %>

<div class="row my-4 justify-content-center">
    <div class="col-lg-8 col-md-10 col-12 px-3">
        <div class="card border shadow-sm p-4 p-md-5 rounded-4 bg-body-tertiary">
            
            <!-- Header Banner -->
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="rounded-circle bg-danger-subtle text-danger p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                    <i class="fa-solid fa-pen-to-square fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1">Edit Your Listing</h3>
                    <p class="text-secondary small mb-0">Update your property details, pricing, categories, or photos below.</p>
                </div>
            </div>

            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">

                <!-- Section 1: Basic Information -->
                <div class="mb-4">
                    <h5 class="fw-bold mb-3 text-secondary small text-uppercase tracking-wider">
                        <i class="fa-solid fa-circle-info text-danger me-1"></i> Basic Information
                    </h5>

                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold">Property Title</label>
                        <input name="listing[title]" id="title" value="<%= listing.title %>" type="text" class="form-control form-control-lg rounded-3 fs-6" required>
                        <div class="valid-feedback">Title looks good</div>
                        <div class="invalid-feedback">Please enter a Title</div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <textarea name="listing[description]" id="description" rows="4" class="form-control rounded-3 fs-6" required><%= listing.description %></textarea>
                        <div class="valid-feedback">Description looks good</div>
                        <div class="invalid-feedback">Please enter a short description</div>
                    </div>

                    <!-- Categories -->
                    <div class="mb-3">
                        <label for="categories" class="form-label fw-semibold">Categories</label>
                        <select id="categories" name="listing[categories][]" multiple placeholder="Search or add categories...">
                            <% categories.forEach(category => { %>
                                <option value="<%= category.name %>" <%= listing.categories.includes(category.name) ? "selected" : "" %>>
                                    <%= category.name %>
                                </option>
                            <% }) %>
                        </select>
                        <small class="text-secondary d-block mt-1">
                            Search categories, select multiple, or type a new tag and press Enter.
                        </small>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Section 2: Photos -->
                <div class="mb-4">
                    <h5 class="fw-bold mb-3 text-secondary small text-uppercase tracking-wider">
                        <i class="fa-solid fa-camera text-danger me-1"></i> Listing Image
                    </h5>

                    <!-- Current Image Preview -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Current Image Preview</label>
                        <div>
                            <img src="<%= originalImageUrl %>" class="img-fluid rounded-3 border shadow-sm" alt="Listing Image" style="max-height: 180px; object-fit: cover;">
                        </div>
                    </div>

                    <!-- Upload New Image -->
                    <div class="mb-3">
                        <label for="image" class="form-label fw-semibold">Upload New Image (Optional)</label>
                        <input name="listing[image]" id="image" type="file" class="form-control form-control-lg rounded-3 fs-6">
                        <small class="text-secondary d-block mt-1">Leave empty if you wish to keep the current image.</small>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Section 3: Pricing & Location -->
                <div class="mb-4">
                    <h5 class="fw-bold mb-3 text-secondary small text-uppercase tracking-wider">
                        <i class="fa-solid fa-location-dot text-danger me-1"></i> Pricing & Location
                    </h5>

                    <div class="row g-3">
                        <!-- Price -->
                        <div class="mb-3 col-md-5">
                            <label for="price" class="form-label fw-semibold">Price per Night</label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-3 bg-body-secondary text-body fw-bold">&#8377;</span>
                                <input type="number" name="listing[price]" id="price" value="<%= listing.price %>" class="form-control form-control-lg rounded-end-3 fs-6" min="0" required>
                            </div>
                            <div class="invalid-feedback">Please enter valid Price</div>
                        </div>

                        <!-- Country -->
                        <div class="mb-3 col-md-7">
                            <label for="country" class="form-label fw-semibold">Country</label>
                            <input name="listing[country]" id="country" value="<%= listing.country %>" type="text" class="form-control form-control-lg rounded-3 fs-6" required>
                            <div class="invalid-feedback">Enter Country name</div>
                        </div>
                    </div>

                    <!-- Location -->
                    <div class="mb-3">
                        <label for="location" class="form-label fw-semibold">Location / Address</label>
                        <input name="listing[location]" id="location" value="<%= listing.location %>" type="text" class="form-control form-control-lg rounded-3 fs-6" required>
                        <div class="invalid-feedback">Enter correct Location</div>
                    </div>

                    <!-- Map Preview -->
                    <div class="mb-3">
                        <button type="button" id="preview-location-btn" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 fw-semibold">
                            <i class="fa-solid fa-map-location-dot me-1"></i> Preview on Map
                        </button>
                        <div id="map-preview" class="mt-3 rounded-3 border overflow-hidden"
                             <% if(listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length===2){ %>
                                 data-lng="<%= listing.geometry.coordinates[0] %>"
                                 data-lat="<%= listing.geometry.coordinates[1] %>"
                             <% }else{ %>
                                 style="display:none;"
                             <% } %>>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Submit Button -->
                <div class="d-grid mt-4">
                    <button class="btn add-btn text-white py-3 px-4 rounded-pill fs-6 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="fa-solid fa-check-circle fs-5"></i> Save Changes
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
new TomSelect("#categories",{
    plugins:["remove_button"],
    create:true,
    persist:false,
    createOnBlur:true,
    maxItems:null,
    placeholder:"Search or add categories..."
});
</script>

<script src="/js/map.js"></script>