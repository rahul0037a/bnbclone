<% layout("layouts/boilerplate") %>

<%
const formatDate = (date) => {
    return new Date(date).toLocaleDateString("en-IN", {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    });
};
%>

<div class="container my-5">
    <h2 class="fw-bold mb-4" style="color: #222222;"><i class="fa-solid fa-suitcase text-danger"></i> My Bookings</h2>
    
    <% if (bookings.length === 0) { %>
        <div class="text-center my-5 py-5 border rounded-4 bg-light" style="border-style: dashed !important;">
            <div class="mb-4">
                <i class="fa-solid fa-plane-departure fa-5x text-muted opacity-50"></i>
            </div>
            <h3 class="fw-bold text-dark">No trips booked yet</h3>
            <p class="text-muted fs-5">Time to dust off your bags and start planning your next getaway.</p>
            <a href="/listings" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold mt-3" style="background-color: #ff385c; border-color: #ff385c;">
                Start Exploring
            </a>
        </div>
    <% } else { %>
        <div class="row">
            <% for (let booking of bookings) { %>
                <% 
                const nights = Math.ceil((new Date(booking.checkOutDate) - new Date(booking.checkInDate)) / (1000 * 60 * 60 * 24)); 
                %>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 position-relative" style="border-radius: 16px; overflow: hidden;">
                        <!-- Listing Image -->
                        <div style="height: 180px; position: relative; overflow: hidden;">
                            <img src="<%= booking.listing.image.url %>" class="w-100 h-100" style="object-fit: cover;" alt="<%= booking.listing.title %>">
                            <span class="badge bg-dark position-absolute" style="top: 15px; right: 15px; font-size: 0.85rem;">
                                <%= nights %> <%= nights === 1 ? 'Night' : 'Nights' %>
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold text-dark mb-1">
                                <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none text-dark hover-underline"><%= booking.listing.title %></a>
                            </h5>
                            <p class="text-muted small mb-3"><%= booking.listing.location %>, <%= booking.listing.country %></p>

                            <!-- Dates -->
                            <div class="bg-light p-2 rounded mb-3 text-center small border">
                                <div class="row">
                                    <div class="col-6 border-end">
                                        <span class="text-muted d-block small">Check-In</span>
                                        <strong class="text-dark"><%= formatDate(booking.checkInDate) %></strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted d-block small">Check-Out</span>
                                        <strong class="text-dark"><%= formatDate(booking.checkOutDate) %></strong>
                                    </div>
                                </div>
                            </div>

                            <!-- Room & Guests Details -->
                            <div class="row mb-3 small">
                                <div class="col-6">
                                    <span class="text-muted">Rooms:</span> <strong class="text-dark"><%= booking.numberOfRooms %></strong>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted">Guests:</span> <strong class="text-dark"><%= booking.numberOfPeople %></strong>
                                </div>
                            </div>

                            <!-- Booking ID Section -->
                            <div class="border-top pt-3 mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Booking ID:</span>
                                    <div class="d-flex align-items-center">
                                        <code class="text-dark me-2 small text-truncate d-inline-block" style="max-width: 90px; vertical-align: bottom;" id="id-<%= booking._id %>" title="<%= booking._id %>"><%= booking._id %></code>
                                        <button class="btn btn-link p-0 text-decoration-none text-danger small fw-semibold" onclick="copyId('<%= booking._id %>')">
                                            Copy
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                    <div>
                                        <span class="text-muted small d-block">Total Paid</span>
                                        <strong class="fs-5 text-dark">&#8377; <%= booking.totalPrice.toLocaleString("en-IN") %></strong>
                                    </div>
                                    <a href="/bookings/<%= booking._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">Receipt</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>

<script>
    function copyId(id) {
        navigator.clipboard.writeText(id).then(() => {
            alert("Booking ID copied to clipboard!");
        });
    }
</script>
