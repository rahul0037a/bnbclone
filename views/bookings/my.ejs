<% layout("layouts/boilerplate") %>
<section class="page-section"><div class="page-heading"><span class="eyebrow">YOUR TRAVEL JOURNAL</span><h1>Good places. Great plans.</h1><p class="muted">Your upcoming adventures and past demo stays, all in one place.</p></div><% if(!bookings.length) { %><div class="empty-state panel my-4"><i class="fa-solid fa-suitcase-rolling fa-2x mb-3" aria-hidden="true"></i><h2>No trips on the calendar. Yet.</h2><p class="muted">A mountain morning or a new city could be closer than you think.</p><a class="button button-brand" href="/listings">Find your next stay</a></div><% } else { %><div class="trip-list mt-4"><% bookings.forEach(booking => { %><%- include('../includes/trip-card',{booking,incoming:false}) %><% }) %></div><% } %></section>
