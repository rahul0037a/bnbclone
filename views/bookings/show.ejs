<% layout("layouts/boilerplate") %>
<% const money=n=>Number(n).toLocaleString('en-IN',{maximumFractionDigits:2}); const date=d=>new Date(d).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}); %>
<section class="receipt-page page-section"><div class="panel"><div class="receipt-head"><div><span class="eyebrow">YOUR WANDERLUST ITINERARY</span><h1 class="receipt-title"><%= booking.status === 'cancelled' ? 'Plans changed. That’s okay.' : 'Your next chapter is planned.' %></h1><p class="muted small mb-0">Demo reservation · No payment collected</p></div><span class="status-pill status-<%= booking.status %>"><i class="fa-solid <%= booking.status === 'cancelled' ? 'fa-ban' : 'fa-check' %>" aria-hidden="true"></i> <%= booking.status === 'cancelled' ? 'Cancelled' : 'Confirmed' %></span></div><p class="receipt-code">Reservation <span id="booking-code"><%= booking._id %></span> <button type="button" class="btn btn-sm" data-copy-booking="<%= booking._id %>" aria-label="Copy reservation identifier"><i class="fa-regular fa-copy" aria-hidden="true"></i></button><span id="copy-status" role="status"></span></p><% if(snapshot.imageUrl) { %><img class="summary-photo" style="height:240px" src="<%= snapshot.imageUrl %>" alt="Saved reservation cover photograph"><% } %><h2 class="h4 fw-bold"><%= snapshot.title %></h2><p class="muted"><%= snapshot.location %><%= snapshot.country ? ', ' + snapshot.country : '' %></p><dl class="receipt-grid"><div><dt>CHECK-IN</dt><dd><%= date(booking.checkInDate) %></dd></div><div><dt>CHECK-OUT</dt><dd><%= date(booking.checkOutDate) %></dd></div><div><dt>YOUR GROUP</dt><dd><%= booking.numberOfPeople %> guests · <%= booking.numberOfRooms %> rooms</dd></div><div><dt>CONTACT EMAIL</dt><dd style="overflow-wrap:anywhere"><%= booking.contactEmail %></dd></div></dl><h2 class="h5 fw-bold mb-3">Your saved price breakdown</h2><div class="price-line"><span>Room / night at reservation</span><span>₹<%= money(pricing.nightlyPrice) %></span></div><div class="price-line"><span><%= pricing.nights %> nights × <%= pricing.rooms %> rooms</span><span>₹<%= money(pricing.subtotal) %></span></div><div class="price-line"><span>Demo tax (<%= Math.round(pricing.taxRate*100) %>%)</span><span>₹<%= money(pricing.taxAmount) %></span></div><div class="price-line total"><span>Demo total</span><span>₹<%= money(pricing.total) %></span></div><div class="catalog-note">This receipt records a demo reservation only. No real property reservation or payment was made. The saved property details and price remain the same if a listing changes or is archived.</div><div class="action-row mt-4"><a class="button button-brand" href="/bookings/my">My trips</a><button type="button" class="button button-outline" data-print-receipt><i class="fa-solid fa-print" aria-hidden="true"></i> Print itinerary</button><% if(canCancel) { %><form method="POST" action="/bookings/<%= booking._id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-outline">Cancel demo reservation</button></form><% } %></div><% if(canCancel) { %><p class="small muted mt-3 mb-0">Cancellation is available until the check-in day and releases the demo room capacity.</p><% } %></div></section><script src="/js/booking.js" defer></script>
