<% layout("layouts/boilerplate") %>
<% const today = new Date().toISOString().slice(0,10); const tomorrow = new Date(Date.now()+86400000).toISOString().slice(0,10); const money = n => Number(n).toLocaleString('en-IN',{maximumFractionDigits:2}); %>
<section class="page-section"><a class="small muted" href="/listings/<%= listing._id %>"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to this stay</a><div class="page-heading mt-3"><span class="eyebrow">A NEW ADVENTURE, IN THE MAKING</span><h1>Plan your demo stay.</h1><p class="muted">Try the reservation experience. No payment or real hotel booking is made.</p></div><div class="booking-layout mt-4"><form action="/listings/<%= listing._id %>/book" method="POST" class="panel booking-panel needs-validation" id="booking-form" data-nightly-price="<%= listing.price %>" novalidate><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2 class="h5 fw-bold mb-4">Your trip details</h2><div class="form-grid"><div class="field"><label for="checkInDate">Check-in</label><input class="form-control" type="date" id="checkInDate" name="checkInDate" value="<%= today %>" min="<%= today %>" required></div><div class="field"><label for="checkOutDate">Check-out</label><input class="form-control" type="date" id="checkOutDate" name="checkOutDate" value="<%= tomorrow %>" min="<%= tomorrow %>" required></div><div class="field"><label for="numberOfPeople">Guests</label><input class="form-control" type="number" id="numberOfPeople" name="numberOfPeople" value="1" min="1" max="<%= listing.maxGuests || 2 %>" step="1" required></div><div class="field"><label for="numberOfRooms">Rooms</label><input class="form-control" type="number" id="numberOfRooms" name="numberOfRooms" value="1" min="1" max="<%= listing.totalRooms || 1 %>" step="1" required></div></div><p class="small muted">Stays can be 1–90 nights. Available capacity is checked again when you confirm.</p><h2 class="h5 fw-bold mt-4 mb-3">Stay in touch</h2><div class="field"><label for="contactEmail">Account email</label><input class="form-control" type="email" id="contactEmail" name="contactEmail" value="<%= currUser.email %>" readonly required autocomplete="email"><small class="muted">Your reservation uses the email on your account.</small></div><div class="field"><label for="contactPhone">Phone number <span class="muted">(optional)</span></label><input class="form-control" type="tel" id="contactPhone" name="contactPhone" minlength="7" maxlength="20" pattern="[+0-9 \(\)\-]{7,20}" placeholder="+91 98765 43210" autocomplete="tel"></div><div class="catalog-note">This is a simulated reservation. Indicative prices, demo inventory, and an illustrative 18% tax are used. Visit the official property website to book an actual stay.</div><button class="button button-brand w-100" type="submit">Confirm demo reservation <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button><p class="small muted mt-3 mb-0">You or the host can cancel before the check-in day. No charge or refund is involved.</p></form><aside class="panel booking-summary"><img class="summary-photo" src="<%= listing.image?.url || '' %>" alt="<%= listing.image?.isIllustrative ? 'Illustrative travel photograph' : listing.title %>"><h2 class="h5 fw-bold"><%= listing.title %></h2><p class="muted small"><%= listing.location %>, <%= listing.country %></p><p class="small muted mb-4"><%= listing.image?.isIllustrative ? 'Illustrative photograph · Indicative demo rate' : 'Demo reservation' %></p><div aria-live="polite" aria-atomic="true"><div class="price-line"><span>Room / night</span><span>₹<%= money(listing.price) %></span></div><div class="price-line"><span>Nights × rooms</span><span><span id="preview-nights">1</span> × <span id="preview-rooms">1</span></span></div><div class="price-line"><span>Subtotal</span><span>₹<span id="preview-subtotal"><%= money(listing.price) %></span></span></div><div class="price-line"><span>Demo tax (18%)</span><span>₹<span id="preview-gst"><%= money(Math.round(listing.price*18)/100) %></span></span></div><div class="price-line total"><span>Demo total</span><span>₹<span id="preview-total"><%= money(Math.round(listing.price*118)/100) %></span></span></div></div></aside></div></section><script src="/js/booking.js" defer></script>
