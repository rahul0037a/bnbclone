<% layout("layouts/boilerplate") %>
<section class="page-section"><div class="page-heading"><span class="eyebrow">YOUR HOSTING JOURNAL</span><h1>A welcome worth looking forward to.</h1><p class="muted">Demo reservations for the places you host, including archived listings.</p></div><% if(!bookings.length) { %><div class="empty-state panel my-4"><i class="fa-solid fa-door-open fa-2x mb-3" aria-hidden="true"></i><h2>Your next guests are still exploring.</h2><p class="muted">Publish a listing and give someone a new place to discover.</p><a class="button button-brand" href="/listings/new">Share your place</a></div><% } else { %><div class="trip-list mt-4"><% bookings.forEach(booking => { %><%- include('../includes/trip-card',{booking,incoming:true}) %><% }) %></div><% } %></section>
