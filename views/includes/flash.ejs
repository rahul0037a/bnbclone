<% if (success && success.length) { %><div class="alert alert-success alert-dismissible fade show flash-message" role="status"><i class="fa-regular fa-circle-check" aria-hidden="true"></i><span><%= success.join(' ') %></span><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button></div><% } %>
<% if (error && error.length) { %><div class="alert alert-danger alert-dismissible fade show flash-message" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><span><%= error.join(' ') %></span><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button></div><% } %>
