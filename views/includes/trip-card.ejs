<% const s = booking.listingSnapshot || {}; const date=d=>new Date(d).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}); %>
<article class="panel trip-card"><% if(s.imageUrl) { %><img src="<%= s.imageUrl %>" alt="Saved cover photograph for <%= s.title %>" loading="lazy"><% } else { %><div class="muted p-4"><i class="fa-solid fa-compass fa-2x" aria-hidden="true"></i></div><% } %><div><span class="status-pill status-<%= booking.status %> mb-2"><%= booking.status === 'cancelled' ? 'Cancelled' : 'Confirmed' %></span><h2><a href="/bookings/<%= booking._id %>"><%= s.title || 'Archived stay' %></a></h2><p class="muted"><%= s.location %><%= s.country ? ', ' + s.country : '' %></p><p><%= date(booking.checkInDate) %> — <%= date(booking.checkOutDate) %></p><p class="muted"><%= booking.numberOfPeople %> guests · <%= booking.numberOfRooms %> rooms<% if(typeof incoming !== 'undefined' && incoming) { %> · Guest: <%= booking.user?.username || 'Former member' %><% } %></p></div><div class="trip-total"><strong>₹<%= Number(booking.totalPrice).toLocaleString('en-IN',{maximumFractionDigits:2}) %></strong><a class="button button-outline" href="/bookings/<%= booking._id %>">View itinerary <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div></article>
