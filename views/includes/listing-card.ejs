<% const cardId = String(listing._id); const cardPhoto = listing.image && listing.image.url; %>
<article class="stay-card" data-listing-card data-listing-id="<%= cardId %>">
  <div class="stay-photo"><a href="/listings/<%= cardId %>" class="photo-link" tabindex="-1" aria-hidden="true"><% if (cardPhoto) { %><img src="<%= cardPhoto %>" alt="" loading="lazy" decoding="async" width="640" height="480"><% } else { %><span class="photo-fallback"><i class="fa-regular fa-image" aria-hidden="true"></i></span><% } %></a>
  <% if (listing.isCatalog) { %><span class="photo-label">The travel edit</span><% } %><button type="button" class="save-button" data-save-id="<%= cardId %>" data-save-title="<%= listing.title %>" aria-label="Save <%= listing.title %>" aria-pressed="false"><i class="fa-regular fa-heart" aria-hidden="true"></i></button></div>
  <div class="stay-content"><p class="stay-location"><%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %></p><h3><a href="/listings/<%= cardId %>"><%= listing.title %></a></h3><p class="stay-meta">Up to <%= listing.maxGuests || 2 %> guests <span>·</span> <%= listing.totalRooms || 1 %> <%= (listing.totalRooms || 1) === 1 ? 'room' : 'rooms' %><% if (listing.categories && listing.categories.length) { %><span>·</span> <%= listing.categories[0] %><% } %></p><p class="stay-price"><strong data-price="<%= Number(listing.price) || 0 %>">₹<%= (Number(listing.price) || 0).toLocaleString('en-IN', {maximumFractionDigits:2}) %></strong><span> / room / night</span><% if (listing.ratesIndicative || listing.isCatalog) { %><span class="rate-note">Indicative rate</span><% } %></p></div>
</article>
