<% layout("layouts/boilerplate") %>
<section class="auth-layout page-section">
  <div class="auth-story"><span class="eyebrow">MAKE ROOM FOR DISCOVERY</span><h1>Your next good story starts here.</h1><p>Find a new city, save a mountain escape, or share a place of your own.</p><p class="small muted">This isolated preview makes demo reservations only. No payment is collected.</p></div>
  <div class="panel auth-panel"><h2>Join WanderLust</h2><p class="muted">A fresh account for your next adventure.</p>
    <form action="/signup" method="POST" class="needs-validation" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="username">Username</label><input class="form-control" id="username" name="username" required pattern="[A-Za-z0-9_]{3,30}" minlength="3" maxlength="30" autocomplete="username" aria-describedby="username-help"><small id="username-help" class="muted">3–30 letters, numbers, or underscores.</small></div>
      <div class="field"><label for="email">Email address</label><input class="form-control" id="email" name="email" type="email" required maxlength="254" autocomplete="email"></div>
      <div class="field"><label for="password">Password</label><input class="form-control" id="password" name="password" type="password" required minlength="10" maxlength="128" pattern="(?=.*[A-Za-z])(?=.*[0-9]).{10,128}" autocomplete="new-password" aria-describedby="password-help"><small id="password-help" class="muted">At least 10 characters, including a letter and a number.</small></div>
      <button class="button button-brand w-100" type="submit">Create account <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
    </form><p class="auth-switch">Already a member? <a href="/login">Log in</a></p>
  </div>
</section>
